# AGED TAKES — environment variables.
#
# Production: paste these into Vercel → your project → Settings → Environment Variables (never into GitHub,
# never into a chat). Local development: copy this file to .env.local and fill it in (.env.local is ignored by git).
#
# Anything starting with NEXT_PUBLIC_ is visible in the browser. Everything else must stay secret.

# ---------------------------------------------------------------------------- REQUIRED
# Supabase → your project → Project Settings → API (or "Connect" → App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Same page, "service_role" (secret). Server-only. Never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of the site, no trailing slash. Use your Vercel address until you own a domain,
# e.g. https://aged-takes.vercel.app — change it to https://agedtakes.com only after DNS is set up.
SITE_URL=https://aged-takes.vercel.app
NEXT_PUBLIC_SITE_URL=https://aged-takes.vercel.app

# The email that becomes the first newsroom admin the first time it signs in.
ADMIN_EMAIL=you@example.com

# Protects the scheduled jobs. Any long random string (32+ characters). Vercel sends it to cron jobs automatically.
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Secrets used to sign newsletter unsubscribe links and hash visitor IPs for rate limiting.
# Long random strings. Set once and don't change NEWSLETTER_SECRET after launch (it would break old unsubscribe links).
NEWSLETTER_SECRET=replace-with-another-long-random-string
RATE_LIMIT_SALT=replace-with-a-third-long-random-string

# ---------------------------------------------------------------------------- AI RESEARCH (optional, recommended)
# console.anthropic.com → API Keys. Requires API billing (a Claude subscription does not include API usage).
# Without it the site works; AI research jobs are simply skipped.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------- EMAIL (optional, recommended)
# resend.com → API Keys. Verify your sending domain in Resend first.
RESEND_API_KEY=
# The "From" address, on your verified domain, e.g.  The Weekly Aged Takes <news@yourdomain.com>
NEWSLETTER_FROM_EMAIL=
# Shown on the About page for right-of-reply and corrections. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------- SOURCE CONNECTORS (all optional)
# SEC requires a descriptive User-Agent with a contact email for automated access, e.g. "Aged Takes research@yourdomain.com".
SEC_USER_AGENT=
# console.cloud.google.com → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=
# coingecko.com/en/api → free Demo key (works without one at low volume).
COINGECKO_API_KEY=
# financialmodelingprep.com → Dashboard → API key (needed only for stock-price predictions).
FMP_API_KEY=

# ---------------------------------------------------------------------------- OPERATIONS (optional)
# Error tracking integration point (see src/lib/log.ts and docs/OPERATIONS.md).
SENTRY_DSN=
# Set to "true" once an attorney has reviewed the Privacy and Terms pages (removes the template notice).
NEXT_PUBLIC_LEGAL_REVIEWED=
# "debug" for verbose server logs.
LOG_LEVEL=
