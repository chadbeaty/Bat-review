# Product Radar environment variables. In production these live in Vercel → Project → Settings → Environment
# Variables. Never commit real values. Everything except the NEXT_PUBLIC_ ones stays on the server.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The app's public address (used in emails and sign-in links)
NEXT_PUBLIC_SITE_URL=https://product-radar.vercel.app

# Your email: becomes the owner on first sign-in and receives alerts
ADMIN_EMAIL=

# Any random string of 32+ characters; Vercel Cron sends it to the scheduled endpoints
CRON_SECRET=

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# YouTube Data API v3 key (console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key)
YOUTUBE_API_KEY=

# Resend (resend.com → API keys). The from-address must be on a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL="Product Radar <radar@yourdomain.com>"
