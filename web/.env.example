# Copy to .env.local for local development, and set the same names in Vercel for staging and production.
# Never commit real values. NEXT_PUBLIC_* values are visible in the browser; everything else must stay server-side.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (Phase 1, optional): enable the Google provider in Supabase Auth first, then set to true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Stripe Connect (Phase 3): use test-mode keys (sk_test_...) until launch. See docs/tracks/payments.md.
STRIPE_SECRET_KEY=
# Signing secret of the platform webhook endpoint (/api/webhooks/stripe, "Your account" events)
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook endpoint (same URL, "Connected accounts" events: account.updated, payout.*)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: a payment method configuration (pmc_...) limited to cards, Apple Pay and Google Pay
STRIPE_PAYMENT_METHOD_CONFIGURATION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Tests only: point the Stripe SDK at stripe-mock (docker run -p 12111:12111 stripe/stripe-mock). Leave unset in production.
# STRIPE_API_HOST=localhost
# STRIPE_API_PORT=12111
# STRIPE_API_PROTOCOL=http

# Shippo (Phase 4): use the test token (shippo_test_...) until launch. Without a token, a clearly labeled fake
# provider returns test rates and "not a real label" PDFs.
SHIPPO_API_TOKEN=
# A long random string. Register the Shippo webhook as https://<site>/api/webhooks/shippo?token=<this value>
SHIPPO_WEBHOOK_SECRET=

# Scheduled order job (/api/cron/orders): a long random string. Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# Resend email (Phase 7)
RESEND_API_KEY=

# Monitoring and analytics (Phase 7)
SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI listing assistant (later)
OPENAI_API_KEY=
